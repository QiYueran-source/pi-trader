{
  "schema_version": 1,
  "mode": "risk_regulator",
  "position_truth": "trade-management.portfolio_snapshot",
  "d_definition": {
    "metric": "abs(current_price / leg_anchor - 1)",
    "leg_anchor": "last_grid_fill_price",
    "note": "滚动锚：成交后锚同步前移；校准价只用于价格边界"
  },
  "escalation_levels": {
    "L0": { "d_min": 0.0, "k_step": 1.0, "k_size": 1.0, "label": "正常" },
    "L1": { "d_min": 0.05, "k_step": 1.3, "k_size": 0.8, "label": "减速" },
    "L2": { "d_min": 0.1, "k_step": 1.6, "k_size": 0.6, "label": "明显减速" },
    "L3": { "d_min": 0.15, "k_step": 2.0, "k_size": 0.5, "label": "极端减速" }
  },
  "hard_constraints": {
    "weight_base": "system_nav",
    "weight_base_note": "体系口径总资产 = 双标的持仓市值 + 体系现金",
    "leg_max_weight": 0.4,
    "total_max_weight": 0.85,
    "cash_min_weight": 0.15,
    "single_trade_max_amount": 2000,
    "on_breach": "stop_buy",
    "resume": "weight_back_below_threshold"
  },
  "hysteresis": {
    "confirm_trading_days": 3,
    "max_step_change_per_leg_per_week": 1,
    "hard_constraint_effective": "immediate"
  },
  "policy": {
    "liquidation": "forbidden",
    "reduce_position": "forbidden",
    "stop_loss": "not_applicable",
    "reverse_t": "forbidden",
    "extreme_action": "stop_buy_only"
  },
  "sell_side": {
    "step_affected_by_level": false,
    "size_affected_by_level": false
  }
}
