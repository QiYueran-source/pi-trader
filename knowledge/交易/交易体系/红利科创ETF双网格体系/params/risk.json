{
  "schema_version": 2,
  "scope": {
    "instrument_ids": ["dividend", "growth"],
    "evaluate_on_trading_days_only": true
  },
  "capital_constraints": {
    "weight_base": "system_nav",
    "leg_max_weight": 0.4,
    "total_max_weight": 0.85,
    "cash_min_weight": 0.15,
    "single_trade_max_amount": 2000,
    "on_breach": "stop_buy"
  },
  "price_boundary": {
    "reference": "latest_grid_calibration",
    "by_instrument": {
      "dividend": { "reference_price": 1.443, "lower_boundary": 1.08225, "upper_boundary": 1.8759 },
      "growth": { "reference_price": 0.944, "lower_boundary": 0.6608, "upper_boundary": 1.2272 }
    },
    "note": "价格边界不参与档位递推，仅用于越界提示与人工复核"
  },
  "market_anomalies": {
    "consecutive_down_trading_days": 5,
    "consecutive_down_loss_ratio": 0.03,
    "sharp_drop_ratio": 0.02,
    "sharp_drop_volume_ratio": 2.0,
    "sharp_rise_notice_ratio": 0.02,
    "sharp_rise_take_profit_notice_ratio": 0.03
  },
  "volatility": {
    "average_range_window_trading_days": 22,
    "expansion_delta_ratio": 0.001
  }
}
