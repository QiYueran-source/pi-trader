{
  "schema_version": 1,
  "scope": {
    "instrument_ids": ["dividend"],
    "evaluate_on_trading_days_only": true
  },
  "capital_constraints": {
    "single_trade_max_amount": 2000,
    "single_trade_max_ratio": 0.25,
    "position_fuse_ratio": 0.8
  },
  "price_boundary": {
    "reference": "latest_grid_calibration",
    "lower_deviation_ratio": 0.25,
    "upper_deviation_ratio": 0.3
  },
  "market_anomalies": {
    "consecutive_down_trading_days": 5,
    "consecutive_down_loss_ratio": 0.03,
    "sharp_drop_ratio": 0.02,
    "sharp_drop_volume_ratio": 2.0,
    "sharp_rise_notice_ratio": 0.02,
    "sharp_rise_take_profit_notice_ratio": 0.03
  },
  "volatility": {
    "average_range_window_trading_days": 22,
    "expansion_delta_ratio": 0.001
  }
}
