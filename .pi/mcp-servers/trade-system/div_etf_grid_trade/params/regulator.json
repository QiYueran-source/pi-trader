{
  "schema_version": 2,
  "version": "v4",
  "effective_from": "2026-10-16",
  "mode": "savings_grid_manual_approval",
  "positioning": "价格驱动的长期定投储蓄：机械层只出参数与建议，防守档切换需人工审批；无清仓、无减仓、无止损；允许 T（含日内）。",
  "normal_state": {
    "note": "常态参数（读配置，随时可调）；档距为固定值，不使用回撤公式或波动率自适应。",
    "dividend": {
      "name": "红利ETF易方达",
      "code": "515180.SH",
      "buy_step_ratio": 0.02,
      "sell_step_ratio": 0.03,
      "buy_shares": 1000,
      "sell_shares": 800,
      "buy_enabled": true,
      "sell_enabled": true
    },
    "growth": {
      "name": "双创50ETF易方达",
      "code": "159781.SZ",
      "buy_step_ratio": 0.046,
      "sell_step_ratio": 0.046,
      "buy_shares": 1000,
      "sell_shares": 1000,
      "buy_enabled": true,
      "sell_enabled": true
    }
  },
  "execution": {
    "ladder_owner": "broker_software",
    "anchor_owner": "broker_software",
    "system_calculates_rung_price": false,
    "preload_rungs": 1,
    "anchor_reset": "weekly_when_flat",
    "anchor_reset_note": "无持仓时每周重设基准价；参数（档距/份数）变更不需要重设基准价",
    "plan_output": "参数版（档距/份数/买卖开关/防守档/硬闸提示），不输出逐档价格"
  },
  "scaling": {
    "note": "每个量吃哪些倍数：defense=防守倍数（defense_levels）、capital=资金倍数（capital_guard.tiers）；倍数数值不在此处重复",
    "buy_step_ratio": {"factors": ["defense", "capital"], "cap": "step_cap"},
    "sell_step_ratio": {"factors": ["defense"], "cap": null},
    "buy_shares": {"factors": ["defense"], "rounding": "floor100"},
    "sell_shares": {"factors": ["defense"], "rounding": "floor100"}
  },
  "capital_guard": {
    "weight_base": "system_nav",
    "weight_base_note": "体系口径总资产 = 双标的持仓市值 + 体系现金（收盘口径，盘后判定）",
    "tiers": [
      {
        "u": 0.5,
        "step_multiplier": 1.2
      },
      {
        "u": 0.7,
        "step_multiplier": 1.3
      }
    ],
    "stop_buy_u": 0.8,
    "resume_u": 0.75,
    "leg_max_weight": 0.45,
    "stacking": "multiply_then_cap",
    "step_cap": {
      "dividend": 0.06,
      "growth": 0.1
    }
  },
  "defense_levels": {
    "A0": {
      "step_multiplier": 1,
      "shares_multiplier": 1,
      "label": "常态"
    },
    "A1": {
      "step_multiplier": 1.2,
      "shares_multiplier": 1,
      "label": "减速"
    },
    "A2": {
      "step_multiplier": 1.4,
      "shares_multiplier": 0.75,
      "label": "明显减速"
    },
    "A3": {
      "step_multiplier": 1.6,
      "shares_multiplier": 0.5,
      "label": "极端减速"
    },
    "note": "升档与降档均需人工审批；审批后由系统生成交易计划，再在券商软件改参数"
  },
  "signals": {
    "note": "信号只用于生成汇报与建议档，不直接切换任何参数",
    "shock": {
      "min_pct": 0.02,
      "sigma_mult": 1.2,
      "vol_heavy_mult": 1.5,
      "vol_dry_mult": 1,
      "window": 20
    },
    "second_order": {
      "window_days": 5,
      "recover_ratio": 0.5,
      "new_low_window_days": 20
    },
    "slow_bleed": {
      "down_days": 4,
      "cum_pct": 0.03,
      "sigma_mult": 1.5
    },
    "emotion": {
      "limit_down_count": {
        "l1": 30,
        "l2": 60
      },
      "advance_decline_ratio": {
        "l1": 8,
        "l2": 15
      },
      "index_drop_pct": 0.02,
      "board_aware_limit": true,
      "board_aware_note": "涨停/跌停按分板幅度判定：主板 10%、创业板/科创板 20%、北交所 30%"
    },
    "text": {
      "sources": [
        "交易/财经分析/{date}/",
        "事实/{date}/市场午评",
        "事实/{date}/市场收评",
        "交易/交易复盘/{date}/"
      ],
      "labels": [
        "结构性恶化",
        "一次性外部冲击",
        "无明确催化"
      ],
      "valid_days": 5,
      "note": "文本用于判断\"情绪恶化的性质\"，量化指标用于判断\"程度\"；文本结论必须带来源路径与原句引用"
    }
  },
  "approval": {
    "required_for": [
      "level_up",
      "level_down"
    ],
    "default_effect": "none（未审批=不切换）",
    "channels": [
      "复盘（2230 复盘追问 / 会话）",
      "0915 通报（仅提醒待决策项）"
    ],
    "plan_after_approval": true,
    "record_fields": [
      "date",
      "leg",
      "from_level",
      "to_level",
      "decided_at",
      "channel",
      "reason",
      "signal_summary"
    ],
    "record_location": "交易/过程资料/{date}/红利科创ETF双网格体系/human_review.json"
  },
  "reserve_shares": {
    "enabled": true,
    "mode": "shares",
    "per_leg": {
      "dividend": 0,
      "growth": 0
    },
    "note": "保底仓：下限 0 表示当前不设底仓（不触发停卖）；设为正的 100 整数倍即启用——持仓触达下限即停卖该腿（产物给 sell_disabled_reason=reserve_floor），回到下限之上自动恢复；券商端同步设最低保留数量，机械层只出开关与原因"
  },
  "policy": {
    "liquidation": "forbidden",
    "reduce_position": "forbidden",
    "stop_loss": "not_applicable",
    "reverse_t": "allowed",
    "day_t": "allowed",
    "extreme_action": "stop_buy_only"
  }
}
