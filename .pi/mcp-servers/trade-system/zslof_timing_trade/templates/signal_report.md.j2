{%- set signal_labels = {
  'buy': '买入',
  'sell': '普通卖出',
  'stop_loss_sell': '止损卖出',
  'chase_buy': '追回买入'
} -%}
{%- set action_labels = {
  'buy': '买入',
  'sell_all': '全部卖出',
  'hold': '持有',
  'no_action': '无动作'
} -%}
