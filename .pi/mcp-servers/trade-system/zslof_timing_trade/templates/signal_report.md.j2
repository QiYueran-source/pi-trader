{%- set exec_text = {'next_open': '次日开盘', 'close_confirmed': '收盘确认'}.get(signal.parameters.execution_timing, signal.parameters.execution_timing) -%}
{%- set vol_ratio_text = '—' if signal.market.volume_change_ratio is none else '%.1f%%'|format(signal.market.volume_change_ratio * 100) -%}
