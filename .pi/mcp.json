{
  "mcpServers": {
    "div-etf-grid-trade": {
      "command": "/opt/venv/bin/python",
      "args": [
        "/pi-trader/.pi/mcp-servers/trade-system/div_etf_grid_trade/mcp_server.py"
      ]
    },
    "tushare-data": {
      "command": "/opt/venv/bin/python",
      "args": [
        "/pi-trader/.pi/mcp-servers/tushare/mcp_server.py"
      ]
    },
    "trade-management": {
      "command": "/opt/venv/bin/python",
      "args": [
        "/pi-trader/.pi/mcp-servers/trade/mcp_server.py"
      ],
      "env": {
        "TRADE_DB_PATH": "/pi-trader/database/trade_management.db"
      }
    },
    "financial-analysis": {
      "command": "/opt/venv/bin/python",
      "args": [
        "/pi-trader/.pi/mcp-servers/financial-analysis/mcp_server.py"
      ],
      "env": {
        "FINANCIAL_ANALYSIS_DB_PATH": "/pi-trader/database/financial_analysis.db"
      }
    },
    "archive-management": {
      "command": "/opt/venv/bin/python",
      "args": [
        "/pi-trader/.pi/mcp-servers/archive-management/mcp_server.py"
      ],
      "env": {
        "KNOWLEDGE_ROOT": "/pi-trader/knowledge",
        "ARCHIVE_ROOT": "/pi-trader/archive",
        "FINANCIAL_ANALYSIS_DB_PATH": "/pi-trader/database/financial_analysis.db"
      }
    },
    "logic-path": {
      "command": "/opt/venv/bin/python",
      "args": [
        "/pi-trader/.pi/mcp-servers/logic-path/mcp_server.py"
      ],
      "env": {
        "KNOWLEDGE_ROOT": "/pi-trader/knowledge",
        "ARCHIVE_ROOT": "/pi-trader/archive"
      }
    },
    "scratch-space-management": {
      "command": "/opt/venv/bin/python",
      "args": [
        "/pi-trader/.pi/mcp-servers/scratch-space-management/mcp_server.py"
      ],
      "env": {
        "SCRATCH_ROOT": "/pi-trader/.scratch-space"
      }
    },
    "todo-management": {
      "command": "/opt/venv/bin/python",
      "args": [
        "/pi-trader/.pi/mcp-servers/todo-management/mcp_server.py"
      ],
      "env": {
        "KNOWLEDGE_ROOT": "/pi-trader/knowledge",
        "ARCHIVE_ROOT": "/pi-trader/archive",
        "TODO_DB_PATH": "/pi-trader/database/todo_index.db"
      }
    }
  }
}
