FROM node:24-bookworm-slim

RUN sed -i \
      -e 's@deb.debian.org@mirrors.aliyun.com@g' \
      -e 's@security.debian.org@mirrors.aliyun.com@g' \
      /etc/apt/sources.list.d/debian.sources \
  && apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    git \
    ripgrep \
    jq \
  && rm -rf /var/lib/apt/lists/*

ARG NPM_REGISTRY=https://registry.npmmirror.com
ARG PI_UID=1000
ARG PI_GID=1000

# 下载pi
RUN npm config set registry "${NPM_REGISTRY}" \
  && npm install -g --ignore-scripts @earendil-works/pi-coding-agent

# 提供依赖  
COPY .rely/uv /usr/local/bin/uv
COPY .rely/uvx /usr/local/bin/uvx
RUN chmod +x /usr/local/bin/uv /usr/local/bin/uvx

# 虚拟环境
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python
ENV UV_CACHE_DIR=/opt/uv/cache

COPY requirements.txt /tmp/requirements.txt
RUN mkdir -p /opt/uv/python /opt/uv/cache /opt/venv \
  && uv venv /opt/venv --python 3.12 \
  && uv pip install \
       --python /opt/venv/bin/python \
       -r /tmp/requirements.txt \
       -i https://pypi.tuna.tsinghua.edu.cn/simple \
  && chmod -R a+rX /opt/uv /opt/venv \
  && echo "Python interpreter: $(readlink -f /opt/venv/bin/python)" \
  && /opt/venv/bin/python --version \
  && test -x /opt/venv/bin/python
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

# 将官方 node 用户调整为宿主机用户的 UID/GID，运行时不使用 root。
RUN groupmod --gid "${PI_GID}" node \
  && usermod --uid "${PI_UID}" --gid "${PI_GID}" node \
  && mkdir -p /home/node/.pi/agent \
  && chown -R node:node /home/node

ENV HOME=/home/node
ENV PI_MODEL_CONFIG=/home/node/.pi/agent/models.json

# 工作目录
WORKDIR /pi-trader

# 启动脚本
COPY entrypoint.sh /usr/local/bin/pi-entrypoint
RUN chmod +x /usr/local/bin/pi-entrypoint

USER node
ENTRYPOINT ["/usr/local/bin/pi-entrypoint"]
